#!/usr/bin/env bash
# PreToolUse guard: deny the gh shapes that corrupt an issue/PR body silently.
#
#   gh issue|pr create|comment|edit ... --body-file <f> | -F <f>  -> deny
#   gh issue|pr create|comment|edit ... --body|-b "@path"         -> deny
#   anything else                                                  -> no decision
#
#   --body-file / -F : on native Windows `gh` reads the file as cp1252, not
#   UTF-8, so every non-ASCII character is double-encoded.
#   --body "@path"   : only `gh api` expands `@<path>`; `gh issue|pr` posts
#   the literal path as the body and exits 0.
#
# Plain inline `--body "text"` is safe, and `gh api` is never touched: its
# `@<path>` expansion and its `-F` are what the GitHub adapter is built on.
#
# The rules live in tickets/scripts/shell_cmd.py, which reads the command the
# way the shell runs it: continuations folded, split into simple commands
# outside quotes, heredoc bodies dropped, `VAR=x` and `command` prefixes
# stripped. So `git commit -F -` whose message mentions a gh command is not
# a gh call, and `GH_REPO=o/r gh issue create \<newline> --body-file b` is.
#
# Never emits "allow": a hook's allow skips the user's own permission rules
# for the call. It denies or stays silent. Fail-open by construction (no
# Python 3.11 means no decision): a body that fails to post can be posted
# again, so nothing here is worth blocking unrelated work over.

set -uo pipefail

# No forks on the pass-through path: this runs before every Bash call.
IFS= read -r -d '' input || true
case "$input" in
  *gh*issue*|*gh*[[:space:]]pr[[:space:]]*) ;;
  *) exit 0 ;;
esac

script="$(cd "$(dirname "$0")/.." && pwd)/tickets/scripts/shell_cmd.py"
for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    printf '%s' "$input" | "$py" "$script" gh-body-guard
    exit 0
  fi
done
exit 0
