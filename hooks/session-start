#!/usr/bin/env bash
# SessionStart hook for the plan-staged-rollout plugin.
#
# If the current repo has a staged rollout in progress (a .plan/ directory at
# the repo root), inject a short context nudge naming the next runnable stage
# so a fresh session surfaces the rollout without the user having to remember
# the namespaced /plan-staged-rollout:plan-run command. The nudge only OFFERS —
# execution is still governed by the operating protocol in .plan/PLAN.md.
#
# Hard constraint: FAIL SILENT. This hook runs in every session in the repo,
# so on malformed .plan/ files or any parse ambiguity it must emit nothing and
# exit 0 — never error, never block a session. In the common case (no .plan/)
# it emits nothing at essentially zero cost.

# Nothing this script could write to stderr is worth risking a session over.
exec 2>/dev/null

# Performance: helpers return their result in the global REPLY, never through
# `$(...)` or a pipe. Every command substitution forks a subshell, and on
# Windows (Git Bash) each fork costs tens of milliseconds — per table cell,
# that made the hook's run time grow with the plan until a large plan ran
# past the SessionStart startup deadline. Keep the per-row path fork-free.
# Stay bash 3.2 compatible (macOS /bin/bash): no ${var,,}, no namerefs.

trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    REPLY="$s"
}

# Set REPLY to the canonical lowercase form of a ledger status; fail on
# anything outside the todo/doing/done/blocked/skipped vocabulary.
normalize_status() {
    local rc=0
    shopt -s nocasematch
    case "$1" in
        todo) REPLY=todo ;;
        doing) REPLY=doing ;;
        done) REPLY=done ;;
        blocked) REPLY=blocked ;;
        skipped) REPLY=skipped ;;
        *) rc=1 ;;
    esac
    shopt -u nocasematch
    return "$rc"
}

# Escape string for JSON embedding using bash parameter substitution.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# Parsed LEDGER.md status-table rows (parallel arrays).
ledger_ids=()
ledger_names=()
ledger_statuses=()

# Parsed PLAN.md stage-index rows (parallel arrays).
index_ids=()
index_depends=()
index_models=()
index_efforts=()

# Split a markdown table row into the global `cells` array.
# Fails on non-table lines; separator/header rows are rejected later by
# stage_id_of.
cells=()
split_row() {
    local line="$1"
    case "$line" in
        \|*) ;;
        *) return 1 ;;
    esac
    local body="${line#|}"
    body="${body%|}"
    local IFS='|'
    read -ra cells <<< "$body"
    [ "${#cells[@]}" -ge 2 ]
}

# Succeed when $1 is a well-formed stage id: S<digits> with an optional
# lowercase letter suffix (S12b, a stage inserted between S12 and S13), or SF.
is_stage_id() {
    case "$1" in
        S[0-9]|S[0-9][0-9]|S[0-9][a-z]|S[0-9][0-9][a-z]|SF) return 0 ;;
        *) return 1 ;;
    esac
}

# Set REPLY to the stage id leading a stage cell; fail otherwise.
stage_id_of() {
    local id
    trim "$1"
    id="${REPLY%%[[:space:]]*}"
    is_stage_id "$id" || return 1
    REPLY="$id"
}

# Parse the "## Status" table of LEDGER.md. Unrecognized rows and statuses
# outside the todo/doing/done/blocked/skipped vocabulary are skipped, not
# errors.
parse_ledger() {
    local in_section=0 line id name status
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            '## Status'*) in_section=1; continue ;;
            '## '*) if [ "$in_section" -eq 1 ]; then break; fi ;;
        esac
        [ "$in_section" -eq 1 ] || continue
        split_row "$line" || continue
        stage_id_of "${cells[0]}" || continue
        id="$REPLY"
        trim "${cells[0]}"
        trim "${REPLY#"$id"}"
        name="$REPLY"
        trim "${cells[1]}"
        normalize_status "$REPLY" || continue
        status="$REPLY"
        ledger_ids+=("$id")
        ledger_names+=("$name")
        ledger_statuses+=("$status")
    done < "$1"
}

# Parse the "## Stage index" table of PLAN.md
# (| Stage | File | Depends | mode | exec | model | effort | gate |).
parse_index() {
    local in_section=0 line id
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            '## Stage index'*) in_section=1; continue ;;
            '## '*) if [ "$in_section" -eq 1 ]; then break; fi ;;
        esac
        [ "$in_section" -eq 1 ] || continue
        split_row "$line" || continue
        stage_id_of "${cells[0]}" || continue
        id="$REPLY"
        [ "${#cells[@]}" -ge 3 ] || continue
        index_ids+=("$id")
        trim "${cells[2]}"; index_depends+=("$REPLY")
        trim "${cells[5]:-}"; index_models+=("$REPLY")
        trim "${cells[6]:-}"; index_efforts+=("$REPLY")
    done < "$1"
}

# Set REPLY to the ledger status of a stage id; fail if the id has no ledger
# row.
status_of() {
    local id="$1" j
    for j in "${!ledger_ids[@]}"; do
        if [ "${ledger_ids[$j]}" = "$id" ]; then
            REPLY="${ledger_statuses[$j]}"
            return 0
        fi
    done
    return 1
}

# Set REPLY to the stage-index array position of a stage id; fail if not
# indexed.
index_pos_of() {
    local id="$1" j
    for j in "${!index_ids[@]}"; do
        if [ "${index_ids[$j]}" = "$id" ]; then
            REPLY="$j"
            return 0
        fi
    done
    return 1
}

# A Depends cell is satisfied when empty/"—" or every listed stage id is
# `done` or `skipped` in the ledger — a skip is a settled outcome, not an
# unmet one, so it must not deadlock a dependent. Anything unrecognized counts
# as NOT satisfied — the nudge must never claim a stage is runnable on a guess —
# and sets dep_unparsed so main can also refrain from claiming nothing is
# runnable on a guess.
dep_unparsed=0
deps_satisfied() {
    local deps d dep_status
    trim "${1//,/ }"
    deps="$REPLY"
    case "$deps" in
        ''|'—'|'-'|'–') return 0 ;;
    esac
    for d in $deps; do
        is_stage_id "$d" || { dep_unparsed=1; return 1; }
        status_of "$d" || { dep_unparsed=1; return 1; }
        dep_status="$REPLY"
        case "$dep_status" in
            done|skipped) ;;
            *) return 1 ;;
        esac
    done
    return 0
}

# Set REPLY to one runnable stage as a single markdown bullet body: its id and
# name, the exact plan-run command, and the launch hints from the stage index.
describe_stage() {
    local i="$1" id name num model="" effort="" weight="" pos
    id="${ledger_ids[$i]}"
    name="${ledger_names[$i]}"
    # The number is the id less its S; a letter suffix is already lowercase
    # (12b), so SF is the one id to lowercase.
    num="${id#S}"
    [ "$num" = "F" ] && num="f"
    if index_pos_of "$id"; then
        pos="$REPLY"
        model="${index_models[$pos]}"
        effort="${index_efforts[$pos]}"
    fi
    case "$model" in ''|'—'|'-') ;; *) weight="model \`$model\`" ;; esac
    case "$effort" in ''|'—'|'-') ;; *) weight="${weight:+$weight, }effort \`$effort\`" ;; esac
    printf -v REPLY '**%s%s** — `/plan-staged-rollout:plan-run %s`%s' \
        "$id" "${name:+ — $name}" "$num" "${weight:+ ($weight)}"
}

main() {
    local root
    root="$(git rev-parse --show-toplevel 2>/dev/null)"
    [ -n "$root" ] || root="$PWD"
    local plan_dir="$root/.plan"
    # No .plan/ — the common case in every non-rollout repo: emit nothing.
    [ -d "$plan_dir" ] || return 0
    [ -f "$plan_dir/LEDGER.md" ] || return 0
    [ -f "$plan_dir/PLAN.md" ] || return 0

    parse_ledger "$plan_dir/LEDGER.md" || return 0
    parse_index "$plan_dir/PLAN.md" || return 0
    [ "${#ledger_ids[@]}" -gt 0 ] || return 0

    # Runnable set: every `doing` stage (resumable) plus every `todo` stage
    # whose depends (read from the PLAN.md stage index — a stage missing from
    # that index is invisible to this logic, per PLAN.md) are all `done` or
    # `skipped`.
    # Reported in FULL, never truncated to the first: when the set holds more
    # than one stage the graph fans out there, and those stages can be run
    # concurrently, one fresh session each.
    local runnable=() i pos
    for i in "${!ledger_ids[@]}"; do
        [ "${ledger_statuses[$i]}" = "doing" ] || continue
        runnable+=("$i")
    done
    for i in "${!ledger_ids[@]}"; do
        [ "${ledger_statuses[$i]}" = "todo" ] || continue
        index_pos_of "${ledger_ids[$i]}" || continue
        pos="$REPLY"
        deps_satisfied "${index_depends[$pos]}" || continue
        runnable+=("$i")
    done

    local context
    if [ "${#runnable[@]}" -eq 1 ]; then
        local only="${runnable[0]}" action="run"
        [ "${ledger_statuses[$only]}" = "doing" ] && action="resume — it is \`doing\`, so a session left it partially complete"
        describe_stage "$only"
        context="**Active staged rollout in this repo** (\`.plan/\` present). Exactly one stage is runnable; every other stage is \`done\`, \`skipped\`, or still waiting on a dependency. Next: $REPLY, to $action.

Offer it to the user but do NOT auto-run it: surface this and wait for their go-ahead. The weight check, dependency gate, and operating protocol in \`.plan/PLAN.md\` still govern execution."
    elif [ "${#runnable[@]}" -gt 1 ]; then
        local list="" j suffix
        for j in "${runnable[@]}"; do
            suffix=""
            [ "${ledger_statuses[$j]}" = "doing" ] && suffix=" — \`doing\`, resume it"
            describe_stage "$j"
            list="$list
- $REPLY$suffix"
        done
        context="**Active staged rollout in this repo** (\`.plan/\` present). **${#runnable[@]} stages are runnable right now** — their \`depends\` are all satisfied and none of them depends on another, so they can be run **concurrently, one per fresh session**:
$list

Surface all of them to the user and wait for their go-ahead — do NOT auto-run any. Running more than one at a time is the user's action, one session per stage; you cannot launch independent sessions from here. The weight check, dependency gate, and operating protocol in \`.plan/PLAN.md\` still govern execution."
    else
        local open=0 st
        for st in "${ledger_statuses[@]}"; do
            case "$st" in
                done|skipped) ;;
                *) open=1 ;;
            esac
        done
        if [ "$open" -eq 0 ]; then
            context="**Active staged rollout in this repo** (\`.plan/\` present) — every stage is \`done\` or \`skipped\`, so the plan is ready for closeout. Offer to close it out via \`/plan-staged-rollout:plan-close\`, but do NOT auto-run it: surface this to the user and wait for their go-ahead."
        else
            # A dependency this hook could not read (unknown id format, or an id
            # with no ledger row) means "not runnable" is a guess: say nothing.
            [ "$dep_unparsed" -eq 0 ] || return 0
            context="**Active staged rollout in this repo** (\`.plan/\` present), but no stage is currently runnable — the remaining stages are \`blocked\` or waiting on unmet dependencies. Surface this to the user and point them at \`.plan/LEDGER.md\` — and at \`.plan/BLOCKED.md\` if it exists, which is where an unattended driver, or a stage session that blocked after its stage branch existed, records a block that cannot go in the ledger — for the details. Do not run any stage."
        fi
    fi

    # A stage that blocked mid-stage left its `blocked` row on its own unmerged
    # stage branch, so the LEDGER.md copy read above still says `doing` and the
    # runnable set just built cannot know. `.plan/BLOCKED.md` is where that
    # block is announced on the plan branch (PLAN.md, "Recording a block"), so
    # say it exists rather than letting a stage be offered as an ordinary
    # resume.
    if [ -f "$plan_dir/BLOCKED.md" ]; then
        context="$context

\`.plan/BLOCKED.md\` exists: read it before offering anything above. A \`### S<N>\` section there means that stage is blocked even where \`LEDGER.md\` still reads \`todo\` or \`doing\` — say what it is waiting on, and do not present it as an ordinary resume. The section is deleted by the user once the stage is resolved, never automatically."
    fi

    local escaped
    escaped="$(escape_for_json "$context")"

    # Output context injection as JSON.
    # Cursor hooks expect additional_context (snake_case).
    # Claude Code hooks expect hookSpecificOutput.additionalContext (nested).
    # Copilot CLI (v1.0.11+) and others expect additionalContext (top-level,
    # SDK standard). Claude Code reads BOTH additional_context and
    # hookSpecificOutput without deduplication, so emit only the field the
    # current platform consumes.
    if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
        printf '{\n  "additional_context": "%s"\n}\n' "$escaped"
    elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
        printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"
    else
        printf '{\n  "additionalContext": "%s"\n}\n' "$escaped"
    fi
}

main
exit 0
